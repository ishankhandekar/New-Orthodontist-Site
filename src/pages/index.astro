---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Affiliations from '../components/Affiliations.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import Logistics from '../components/Logistics.astro';
import Treatments from '../components/Treatments.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Office from '../components/Office.astro';
import { fetchDocument, type HomePage } from '../lib/sanity';

// The homepage's text, edited in Sanity Studio ("Homepage"). The public site reads it once while it
// builds; the preview Worker reads it per request, with drafts and click-to-edit markers in draft mode.
const home = await fetchDocument<HomePage>('homePage', { draftMode: Astro.locals.draftMode, stega: true });
---

<Layout>
	<main>
		<Hero content={home.hero} />
		<Affiliations content={home.affiliations} />
		<About content={home.about} />
		<Gallery content={home.gallery} />
		<Treatments content={home.treatments} />
		<Logistics financing={home.financing} firstVisit={home.firstVisit} />
		<Testimonials content={home.reviews} />
		<FAQ content={home.faq} />
		<Office content={home.office} />
	</main>
</Layout>
