---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Affiliations from '../components/Affiliations.astro';
import About from '../components/About.astro';
import Gallery from '../components/Gallery.astro';
import Logistics from '../components/Logistics.astro';
import Treatments from '../components/Treatments.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import Office from '../components/Office.astro';
import { fetchSingleton, type HomePage } from '../lib/sanity';

// The homepage's text, edited in Sanity Studio ("Homepage") and read once while the site builds.
const home = await fetchSingleton<HomePage>('homePage');
---

<Layout>
	<main>
		<Hero content={home.hero} />
		<Affiliations content={home.affiliations} />
		<About content={home.about} />
		<Gallery content={home.gallery} />
		<Treatments content={home.treatments} />
		<Logistics financing={home.financing} firstVisit={home.firstVisit} />
		<Testimonials content={home.reviews} />
		<FAQ content={home.faq} />
		<Office content={home.office} />
	</main>
</Layout>
