---
import { Image } from 'astro:assets';
import ArrowIcon from '../../components/ArrowIcon.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import FactsStrip from '../../components/FactsStrip.astro';
import Layout from '../../layouts/Layout.astro';
import { h2, section, sectionInner, sectionInnerFirst, smallLabel, textLink } from '../../lib/pageStyles';
import { fetchDocument, type OfficePage } from '../../lib/sanity';
import { url } from '../../lib/url';
/*
	Office & Tech: the space, then the tools. The technology section contrasts "the old way" with how
	this office does it, so each tool is explained by what it changes for the patient.
	TODO: Every photo is a stock placeholder; swap in photos of the actual office and equipment.
	Confirm with the practice which technology they use (scanner and X-ray models, treatment
	previews, online forms, text reminders) and the comfort amenities, before launch.
*/
import officePhoto from '../../assets/about-office.jpg';
import loungePhoto from '../../assets/team-sofa.jpg';
import scanPhoto from '../../assets/treatment-invisalign.jpg';
import planPhoto from '../../assets/treatment-jaw.jpg';
import doctorPhoto from '../../assets/about-doctor.jpg';

// The page's text is edited in Sanity Studio (About → Office & tech). Each room's photo stays
// here, matched in order.
const page = await fetchDocument<OfficePage>('page-office', { draftMode: Astro.locals.draftMode, stega: true });
const spacePhotos = [
	{ photo: loungePhoto, alt: 'A bright, relaxed seating area', focus: 'object-[50%_60%]' },
	{ photo: officePhoto, alt: 'A treatment room in the office', focus: 'object-center' },
	{ photo: doctorPhoto, alt: 'Dr. Lee in the consultation room', focus: 'object-[50%_30%]' },
	{ photo: planPhoto, alt: 'A dental model made from a 3D scan', focus: 'object-[50%_62%]' },
];
const spaces = page.spaces.map((s, i) => ({ ...s, ...spacePhotos[i % spacePhotos.length] }));
const { tech, comfort } = page;
---

<Layout title={page.seo.title} description={page.seo.description} image={officePhoto} solidHeader>
	<main class="bg-white text-ink">
		<!-- Hero: the promise, then an uneven three-photo layout -->
		<section class="px-5 pt-28 pb-8 sm:px-7 lg:pt-36 lg:pb-12">
			<div class="mx-auto max-w-7xl">
				<div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-8">
					<div class="lg:col-span-7">
						<nav aria-label="Breadcrumb" class={smallLabel}>
							<span>About us</span>
							<span class="mx-2 text-ink/30" aria-hidden="true">/</span>
							<span aria-current="page" class="text-ink">Office &amp; tech</span>
						</nav>
						<h1 class="mt-6 text-[2.75rem] leading-[1.02] font-normal tracking-[-0.02em] text-balance sm:text-[clamp(3.5rem,6vw,5.5rem)]">
							{page.headline}
						</h1>
					</div>
					<p class="max-w-md text-base leading-relaxed text-ink/75 sm:text-lg lg:col-span-4 lg:col-start-9">
						{page.intro}
					</p>
				</div>

				<div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2 lg:mt-16 lg:gap-5">
					<div class="overflow-hidden rounded-2xl bg-mist sm:col-span-2 sm:row-span-2">
						<Image src={officePhoto} alt="A treatment room in the office" widths={[640, 1024, 1600]} sizes="(min-width: 640px) 66vw, 100vw" loading="eager" class="aspect-[4/3] size-full object-cover" />
					</div>
					<div class="hidden overflow-hidden rounded-2xl bg-mist sm:block">
						<Image src={scanPhoto} alt="Clear aligners made from a 3D scan" widths={[480, 800]} sizes="33vw" loading="eager" class="size-full object-cover object-[58%_center]" />
					</div>
					<div class="hidden overflow-hidden rounded-2xl bg-mist sm:block">
						<Image src={loungePhoto} alt="A bright seating area" widths={[480, 800]} sizes="33vw" loading="eager" class="size-full object-cover object-[50%_60%]" />
					</div>
				</div>
			</div>
		</section>

		<!-- The space -->
		<section aria-labelledby="space-heading" class={section}>
			<div class={sectionInnerFirst}>
				<h2 id="space-heading" class:list={[h2, 'max-w-2xl']}>{page.spaceHeading}</h2>
				<ul class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
					{
						spaces.map((s) => (
							<li>
								<div class="overflow-hidden rounded-2xl bg-mist">
									<Image src={s.photo} alt={s.alt} widths={[480, 800]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class:list={['aspect-[4/5] w-full object-cover', s.focus]} />
								</div>
								<h3 class="mt-5 text-lg font-medium tracking-[-0.01em]">{s.name}</h3>
								<p class="mt-1.5 text-[0.9375rem] leading-relaxed text-ink/75">{s.body}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- The technology: the old way next to ours, so each tool is explained by what it changes -->
		<section aria-labelledby="tech-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-8">
					<h2 id="tech-heading" class:list={[h2, 'lg:col-span-6']}>{page.techHeading}</h2>
					<p class="max-w-md text-[0.9375rem] leading-relaxed text-ink/75 lg:col-span-5 lg:col-start-8">
						{page.techIntro}
					</p>
				</div>

				<!-- Column headings (desktop) -->
				<div class:list={[smallLabel, 'mt-14 hidden grid-cols-12 gap-8 border-b-2 border-ink pb-3 lg:grid']}>
					<span class="col-span-3">Technology</span>
					<span class="col-span-4">The old way</span>
					<span class="col-span-5">With us</span>
				</div>
				<ul class="mt-10 border-b border-ink/10 lg:mt-0">
					{
						tech.map((t) => (
							<li class="grid gap-4 border-t border-ink/10 py-7 lg:grid-cols-12 lg:gap-8 lg:py-8 lg:first:border-t-0">
								<div class="lg:col-span-3">
									<h3 class="text-xl tracking-[-0.01em]">{t.name}</h3>
									<!-- Highlighted only while it's still a [placeholder]. -->
									<p class="mt-1.5 text-sm text-ink/60">
										{t.model.includes('[') ? <mark>{t.model}</mark> : t.model}
									</p>
								</div>
								<p class="text-[0.9375rem] leading-relaxed text-ink/50 lg:col-span-4">
									<span class:list={[smallLabel, 'mr-2 lg:hidden']}>Before</span>
									<span class="line-through decoration-ink/20">{t.before}</span>
								</p>
								<p class="text-[0.9375rem] leading-relaxed lg:col-span-5 lg:text-base">
									<span class:list={[smallLabel, 'mr-2 lg:hidden']}>With us</span>
									{t.now}
								</p>
							</li>
						))
					}
				</ul>
				<a href={url('/first-visit')} class:list={[textLink, 'mt-10']}>
					See how it all fits into your first visit
					<ArrowIcon size={11} class="text-accent transition-transform motion-safe:group-hover:translate-x-0.5" />
				</a>
			</div>
		</section>

		<!-- Comfort and care -->
		<section aria-labelledby="comfort-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<h2 id="comfort-heading" class:list={[h2, 'lg:col-span-4']}>{page.comfortHeading}</h2>
					<div class="lg:col-span-8">
						<FactsStrip facts={comfort} />
						<p class="mt-6 max-w-xl text-sm leading-relaxed text-ink/60">
							{page.sterilizationNote}
						</p>
					</div>
				</div>
			</div>
		</section>

		<ClosingCta heading={page.closing} text={page.closingText} />
	</main>
</Layout>
