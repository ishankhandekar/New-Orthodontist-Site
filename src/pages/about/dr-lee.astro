---
import { Image } from 'astro:assets';
import ArrowIcon from '../../components/ArrowIcon.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import FactsStrip from '../../components/FactsStrip.astro';
import Layout from '../../layouts/Layout.astro';
import { buttonArrow, buttonInk } from '../../lib/buttons';
import { bookHref } from '../../lib/nav';
import { h2, section, sectionInner, sectionInnerFirst, smallLabel, textLink } from '../../lib/pageStyles';
import { url } from '../../lib/url';
// TODO: Placeholder stock photos (not Dr. Lee). Swap for real portraits of Dr. Lee.
import portrait from '../../assets/about-doctor.jpg';
import officePhoto from '../../assets/about-office.jpg';

/*
	Meet Dr. Lee: a profile page. Every personal fact (schools, years, credentials, memberships,
	license number, personal details) is a highlighted <mark> placeholder, because this page states
	facts about a real person; nothing here may be invented. Dr. Lee should supply and approve every
	detail, including whether she is board certified by the American Board of Orthodontics.
*/
const facts = [
	{ label: 'Specialty', value: 'Orthodontics' },
	{ label: 'In practice since', value: '[Year]' },
	{ label: 'Board certified', value: '[Confirm: American Board of Orthodontics]' },
	{ label: 'Sees every patient', value: 'Herself, at every visit' },
];

const approach = [
	{ title: 'With you at every visit', body: 'Dr. Lee sees every patient herself, from the first consultation to the final retainer check. No hand-offs.' },
	{ title: 'Plans you can understand', body: 'She walks you through what she sees and every option, in plain language, so you can decide with confidence.' },
	{ title: 'Care that fits your life', body: 'Treatment planned around school, work, and family, with the most discreet options that will work for you.' },
];

// Each item: when, what, where. Bracketed values are placeholders for Dr. Lee to fill in.
const timeline = [
	{ year: '[Year]', title: 'Undergraduate degree', place: '[University], [Degree]' },
	{ year: '[Year]', title: 'Dental school', place: '[Dental school], [DDS or DMD]' },
	{ year: '[Year]', title: 'Orthodontic residency', place: '[Program], Certificate in Orthodontics' },
	{ year: '[Year]', title: 'Board certification', place: '[Confirm: American Board of Orthodontics]' },
	{ year: '[Year]', title: 'Torrey Hills Orthodontics', place: 'Opened her practice in Carmel Valley' },
];

const credentials = [
	{ org: 'American Board of Orthodontics', role: '[Confirm: Board certified diplomate]', since: '[Year]' },
	{ org: 'American Association of Orthodontists', role: '[Confirm: Member]', since: '[Year]' },
	{ org: 'Dental Board of California', role: 'Licensed, license no. [number]', since: '[Year]' },
	{ org: 'California Dental Association', role: '[Confirm: Member]', since: '[Year]' },
	{ org: 'San Diego County Dental Society', role: '[Confirm: Member]', since: '[Year]' },
	{ org: 'Invisalign', role: '[Confirm: Provider level]', since: '[Year]' },
];

// Render "[...]" values as highlighted placeholders.
const isPlaceholder = (v: string) => v.includes('[');
---

<Layout title="Meet Dr. Judy Lee | Torrey Hills Orthodontics" solidHeader>
	<main class="bg-white text-ink">
		<!-- Hero: a large portrait beside her name and a short introduction -->
		<section class="px-5 pt-28 pb-8 sm:px-7 lg:pt-36 lg:pb-12">
			<div class="mx-auto max-w-7xl">
				<div class="grid items-end gap-10 lg:grid-cols-12 lg:gap-8">
					<div class="overflow-hidden rounded-2xl bg-mist lg:col-span-5">
						<Image
							src={portrait}
							alt="Dr. Judy Lee in the treatment room"
							widths={[640, 1000, 1400]}
							sizes="(min-width: 1024px) 40vw, 100vw"
							loading="eager"
							class="aspect-[4/5] w-full object-cover object-[50%_30%]"
						/>
					</div>
					<div class="lg:col-span-6 lg:col-start-7 lg:pb-4">
						<nav aria-label="Breadcrumb" class={smallLabel}>
							<span>About us</span>
							<span class="mx-2 text-ink/30" aria-hidden="true">/</span>
							<span aria-current="page" class="text-ink">Meet Dr. Lee</span>
						</nav>
						<h1 class="mt-6 text-[2.75rem] leading-[1.02] font-normal tracking-[-0.02em] sm:text-[clamp(3.5rem,6vw,5.5rem)]">
							Dr. Judy Lee
						</h1>
						<p class="mt-3 text-lg text-ink/70">Orthodontist, <mark>[DDS or DMD, MS]</mark></p>
						<p class="mt-8 max-w-md text-base leading-relaxed text-ink/75 sm:text-lg">
							Dr. Lee founded Torrey Hills Orthodontics to give Carmel Valley families something rare: an orthodontist who
							knows every patient personally, plans every smile herself, and is there at every visit.
						</p>
						<a href={url(bookHref)} class:list={[buttonInk, 'mt-9']}>
							Meet her at a free consultation
							<ArrowIcon size={12} class={buttonArrow} />
						</a>
					</div>
				</div>
				<FactsStrip {facts} class="mt-14 lg:mt-20" />
			</div>
		</section>

		<!-- Her approach -->
		<section aria-labelledby="approach-heading" class={section}>
			<div class={sectionInnerFirst}>
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<div class="lg:col-span-4">
						<h2 id="approach-heading" class={h2}>Her approach.</h2>
						<p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-ink/75">
							<mark>[A few sentences in Dr. Lee's own words about why she became an orthodontist and what she loves about it.]</mark>
						</p>
					</div>
					<div class="grid gap-x-8 sm:grid-cols-3 lg:col-span-8">
						{
							approach.map((a) => (
								<div class="border-t-2 border-ink pt-5 pb-8">
									<h3 class="text-xl tracking-[-0.01em]">{a.title}</h3>
									<p class="mt-3 text-[0.9375rem] leading-relaxed text-ink/75">{a.body}</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Education: a horizontal timeline on desktop, vertical on phones -->
		<section aria-labelledby="education-heading" class={section}>
			<div class={sectionInner}>
				<h2 id="education-heading" class:list={[h2, 'max-w-2xl']}>Education and training.</h2>
				<ol class="mt-12 grid gap-y-10 lg:mt-16 lg:grid-cols-5 lg:gap-x-6">
					{
						timeline.map((t, i) => (
							<li class="relative grid grid-cols-[1.25rem_1fr] gap-x-4 lg:block">
								<!-- Dot and connecting line: across on desktop, down on phones -->
								<span class="relative flex justify-center lg:block" aria-hidden="true">
									<span class:list={['relative z-10 mt-1.5 block size-3 rounded-full border-2 lg:mt-0', i === timeline.length - 1 ? 'border-accent bg-accent' : 'border-ink bg-white']} />
									{i < timeline.length - 1 && (
										<span class="absolute top-4 -bottom-12 left-1/2 w-px -translate-x-1/2 bg-ink/15 lg:top-1.5 lg:right-[-1.5rem] lg:bottom-auto lg:left-3 lg:h-px lg:w-auto lg:translate-x-0" />
									)}
								</span>
								<div class="lg:mt-6">
									<p class="text-sm text-ink/60 tabular-nums">{isPlaceholder(t.year) ? <mark>{t.year}</mark> : t.year}</p>
									<h3 class="mt-2 text-lg font-medium tracking-[-0.01em]">{t.title}</h3>
									<p class="mt-1 text-[0.9375rem] leading-relaxed text-ink/75">
										{isPlaceholder(t.place) ? <mark>{t.place}</mark> : t.place}
									</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- Certifications and memberships: typographic, no borrowed logos -->
		<section aria-labelledby="credentials-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<div class="lg:col-span-4">
						<h2 id="credentials-heading" class={h2}>Certifications and memberships.</h2>
						<a href="https://search.dca.ca.gov/" target="_blank" rel="noopener noreferrer" class:list={[textLink, 'mt-8']}>
							Verify her license with the State of California<span class="sr-only"> (opens in a new tab)</span>
							<ArrowIcon size={11} class="-rotate-45 text-accent transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5" />
						</a>
					</div>
					<ul class="grid gap-x-8 border-b border-ink/10 sm:grid-cols-2 lg:col-span-8">
						{
							credentials.map((c) => (
								<li class="flex items-start justify-between gap-6 border-t border-ink/10 py-6">
									<div>
										<p class="text-lg tracking-[-0.01em]">{c.org}</p>
										<p class="mt-1 text-[0.9375rem] text-ink/70">{isPlaceholder(c.role) ? <mark>{c.role}</mark> : c.role}</p>
									</div>
									<p class:list={[smallLabel, 'shrink-0 pt-1.5']}>
										Since {isPlaceholder(c.since) ? <mark>{c.since}</mark> : c.since}
									</p>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- Outside the office: a personal note, with a photo -->
		<section aria-labelledby="outside-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
					<div class="overflow-hidden rounded-2xl bg-mist lg:col-span-6">
						<Image src={officePhoto} alt="The office in Carmel Valley" widths={[640, 1000]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
					</div>
					<div class="lg:col-span-5 lg:col-start-8">
						<h2 id="outside-heading" class={h2}>Outside the office.</h2>
						<p class="mt-5 max-w-md text-[0.9375rem] leading-relaxed text-ink/75">
							<mark>[A short, personal paragraph: family, where she grew up, hobbies, or community involvement in Carmel Valley.]</mark>
						</p>
						<a href={url('/first-visit')} class:list={[textLink, 'mt-8']}>
							See what your first visit with her is like
							<ArrowIcon size={11} class="text-accent transition-transform motion-safe:group-hover:translate-x-0.5" />
						</a>
					</div>
				</div>
			</div>
		</section>

		<ClosingCta heading="Meet Dr. Lee in person." text="Your free consultation is with Dr. Lee herself. Come see what's possible for your smile." />
	</main>
</Layout>
