---
import ArrowIcon from '../components/ArrowIcon.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Layout from '../layouts/Layout.astro';
import { address, directionsUrl, hours, phone } from '../lib/contact';
import { smallLabel, textLink } from '../lib/pageStyles';

/*
	Office hours and location: the essentials, plainly. Hours and address come from lib/contact, so
	they always match the homepage.
	TODO: Confirm the parking, entrance, and accessibility details with the practice.
*/
// Google Maps' keyless embed. It loads Google's map (and its cookies) only when scrolled into view.
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(address.join(', '))}&output=embed`;

const details = [
	{ label: 'Parking', value: 'Free parking in the building lot.' },
	{ label: 'Finding us', value: 'Suite 200, on the second floor. The elevator is just inside the lobby.' },
	{ label: 'Accessibility', value: 'Step-free entrance and elevator access to the office.' },
];
---

<Layout title="Office Hours & Location | Torrey Hills Orthodontics" solidHeader>
	<main class="bg-white text-ink">
		<section class="px-5 pt-28 pb-24 sm:px-7 lg:pt-36 lg:pb-32">
			<div class="mx-auto max-w-7xl">
				<nav aria-label="Breadcrumb" class={smallLabel}>
					<span>Patient info</span>
					<span class="mx-2 text-ink/30" aria-hidden="true">/</span>
					<span aria-current="page" class="text-ink">Office hours &amp; location</span>
				</nav>
				<h1 class="mt-6 text-[2.75rem] leading-[1.02] font-normal tracking-[-0.02em] sm:text-[clamp(3.5rem,6vw,5.5rem)]">
					Find us in Carmel Valley.
				</h1>

				<div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-8">
					<!-- The details -->
					<div class="lg:col-span-5">
						<dl class="border-b border-ink/10">
							<div class="border-t border-ink/10 py-6">
								<dt class={smallLabel}>Address</dt>
								<dd class="mt-2 text-lg leading-snug tracking-[-0.01em]">
									<address class="not-italic">{address[0]}<br />{address[1]}</address>
								</dd>
							</div>
							<div class="border-t border-ink/10 py-6">
								<dt class={smallLabel}>Phone</dt>
								<dd class="mt-2 text-lg tracking-[-0.01em]">
									<a href={phone.href} class="underline decoration-ink/25 underline-offset-4 transition-colors hover:decoration-accent">{phone.display}</a>
								</dd>
							</div>
							<div class="border-t border-ink/10 py-6">
								<dt class={smallLabel}>Office hours</dt>
								<dd class="mt-3">
									<table class="w-full text-lg tracking-[-0.01em]">
										<tbody>
											{
												hours.map((h) => (
													<tr>
														<th scope="row" class="w-32 py-1 text-left font-normal">{h.days}</th>
														<td class="py-1 tabular-nums">
															{h.time}
															{h.rotational && <span class="text-ink/60">*</span>}
														</td>
													</tr>
												))
											}
										</tbody>
									</table>
									<p class="mt-3 text-sm text-ink/60">* Open on a rotating schedule, so call to confirm.</p>
								</dd>
							</div>
						</dl>
						<a href={directionsUrl} target="_blank" rel="noopener noreferrer" class:list={[textLink, 'mt-8']}>
							Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
							<ArrowIcon size={11} class="-rotate-45 text-accent transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5" />
						</a>
					</div>

					<!-- The map -->
					<div class="overflow-hidden rounded-2xl bg-mist lg:col-span-7">
						<iframe
							src={mapSrc}
							title={`Map showing ${address.join(', ')}`}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							class="aspect-[4/3] h-full min-h-[22rem] w-full border-0 lg:aspect-auto"
						></iframe>
					</div>
				</div>

				<!-- Getting here -->
				<dl class="mt-16 grid gap-x-8 border-b border-ink/10 sm:grid-cols-3 lg:mt-24">
					{
						details.map((d) => (
							<div class="border-t border-ink/10 py-6">
								<dt class={smallLabel}>{d.label}</dt>
								<dd class="mt-2 max-w-xs text-[0.9375rem] leading-relaxed">{d.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<ClosingCta
			heading="Come see us."
			text="Your first visit is free, takes about an hour, and you'll meet Dr. Lee herself."
		/>
	</main>
</Layout>
