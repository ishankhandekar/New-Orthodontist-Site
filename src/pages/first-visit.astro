---
import { Image } from 'astro:assets';
import Accordion from '../components/Accordion.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import ClosingCta from '../components/ClosingCta.astro';
import FactsStrip from '../components/FactsStrip.astro';
import Layout from '../layouts/Layout.astro';
import { buttonArrow, buttonInk } from '../lib/buttons';
import { getPracticeInfo } from '../lib/contact';
import { bookHref } from '../lib/nav';
import { h2, section, sectionInner, sectionInnerFirst, smallLabel, textLink } from '../lib/pageStyles';
import { fetchDocument, type FirstVisitPage } from '../lib/sanity';
import { url } from '../lib/url';

/*
	First visit: takes the mystery out of every minute, and leans on photography to build trust.
	Its own layout: a photo-led hero, the visit as a timed itinerary (with a photo that changes as you
	scroll), a tickable checklist, a look inside the office, and practical details.
	TODO: Every photo is a stock placeholder; swap in the practice's own. Confirm with the practice the
	visit length and order, whether X-rays happen at the first visit, how patient forms are sent,
	and the parking and entrance details.
*/
import officePhoto from '../assets/about-office.jpg';
import doctorPhoto from '../assets/about-doctor.jpg';
import scanPhoto from '../assets/treatment-invisalign.jpg';
import planPhoto from '../assets/treatment-jaw.jpg';
import smilePhoto from '../assets/hero-patient.jpg';
import sarahPhoto from '../assets/gallery-sarah.png';
import marcusPhoto from '../assets/gallery-marcus.png';
import childPhoto from '../assets/gallery-priya.png';
const { address, directionsUrl, phone } = await getPracticeInfo(Astro.locals);

// The page's text is edited in Sanity Studio (Patient info → First visit); the photos stay here.
const page = await fetchDocument<FirstVisitPage>('page-first-visit', { draftMode: Astro.locals.draftMode, stega: true });

// One photo per step of the visit, in order. Extra steps added in the Studio reuse these from the start.
const itineraryPhotos = [
	{ photo: officePhoto, alt: 'The bright, calm reception area', focus: 'object-center' },
	{ photo: scanPhoto, alt: 'Clear aligners made from a 3D scan', focus: 'object-[58%_center]' },
	{ photo: doctorPhoto, alt: 'Dr. Lee in the treatment room', focus: 'object-[50%_30%]' },
	{ photo: planPhoto, alt: 'A dental model used to explain the plan', focus: 'object-[50%_62%]' },
	{ photo: sarahPhoto, alt: 'A patient smiling during the visit', focus: 'object-[50%_28%]' },
	{ photo: smilePhoto, alt: 'A smiling patient with braces', focus: 'object-[60%_30%]' },
];
const itinerary = page.itinerary.map((stop, i) => ({ ...stop, ...itineraryPhotos[i % itineraryPhotos.length] }));

// The "look inside" photos; their captions come from the Studio, in order.
const insidePhotos = [
	{ photo: officePhoto, alt: 'The reception area', focus: 'object-center' },
	{ photo: doctorPhoto, alt: 'Dr. Lee', focus: 'object-[50%_30%]' },
	{ photo: marcusPhoto, alt: 'A patient smiling after treatment', focus: 'object-[50%_22%]' },
];
const inside = page.insideCaptions.map((caption, i) => ({ caption, ...insidePhotos[i % insidePhotos.length] }));

// The address comes from Practice info; the other details from the Studio.
const details = [{ label: 'Address', value: address.join(', ') }, ...page.details];

const photoFrame = 'overflow-hidden rounded-2xl bg-mist';
---

<Layout title={page.seo.title} description={page.seo.description} image={officePhoto} solidHeader>
	<main class="bg-white text-ink">
		<!-- Hero: the promise up top, then the office itself, full width -->
		<section class="px-5 pt-28 pb-8 sm:px-7 lg:pt-36 lg:pb-12">
			<div class="mx-auto max-w-7xl">
				<div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-8">
					<div class="lg:col-span-7">
						<nav aria-label="Breadcrumb" class={smallLabel}>
							<span>Patient info</span>
							<span class="mx-2 text-ink/30" aria-hidden="true">/</span>
							<span aria-current="page" class="text-ink">First visit</span>
						</nav>
						<h1 class="mt-6 text-[2.75rem] leading-[1.02] font-normal tracking-[-0.02em] text-balance sm:text-[clamp(3.5rem,6vw,5.5rem)]">
							{page.headline}
						</h1>
					</div>
					<div class="lg:col-span-4 lg:col-start-9">
						<p class="max-w-md text-base leading-relaxed text-ink/75 sm:text-lg">
							{page.intro}
						</p>
						<a href={url(bookHref)} class:list={[buttonInk, 'mt-7']}>
							Book your first visit
							<ArrowIcon size={12} class={buttonArrow} />
						</a>
					</div>
				</div>

				<div class:list={[photoFrame, 'mt-12 lg:mt-16']}>
					<Image
						src={officePhoto}
						alt="The bright, calm reception area of the office"
						widths={[640, 1024, 1600, 2000]}
						sizes="(min-width: 1280px) 1216px, 100vw"
						loading="eager"
						class="aspect-[4/3] w-full object-cover sm:aspect-[21/9]"
					/>
				</div>
				<FactsStrip facts={page.facts} class="mt-10 lg:mt-12" />
			</div>
		</section>

		<!--
			The visit, minute by minute. Desktop: the itinerary scrolls past a pinned photo that changes to
			match the step in view. Phones: each step shows its own photo.
		-->
		<section aria-labelledby="itinerary-heading" class={section} data-itinerary>
			<div class={sectionInnerFirst}>
				<h2 id="itinerary-heading" class:list={[h2, 'max-w-2xl']}>{page.itineraryHeading}</h2>
				<div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-8">
					<ol class="lg:col-span-6">
						{
							itinerary.map((stop, i) => (
								<li data-stop={i} class="stop group grid grid-cols-[3.25rem_1.25rem_1fr] gap-x-3 sm:grid-cols-[4rem_1.5rem_1fr] sm:gap-x-4">
									<span class="stop-time pt-0.5 text-sm text-ink/50 tabular-nums transition-colors">{stop.time}</span>
									<!-- Dot on a thin line; the line runs down to the next stop -->
									<span class="relative flex justify-center" aria-hidden="true">
										<span class="stop-dot relative z-10 mt-1.5 size-2.5 rounded-full border-2 border-ink/30 bg-white transition-colors" />
										{i < itinerary.length - 1 && <span class="absolute top-3 -bottom-2 w-px bg-ink/15" />}
									</span>
									<div class="pb-12 sm:pb-16">
										<h3 class="text-xl tracking-[-0.01em] sm:text-[1.625rem]">{stop.title}</h3>
										<p class="mt-2 max-w-md text-[0.9375rem] leading-relaxed text-ink/75">{stop.body}</p>
										<div class:list={[photoFrame, 'mt-5 lg:hidden']}>
											<Image
												src={stop.photo}
												alt={stop.alt}
												widths={[480, 800]}
												sizes="100vw"
												class:list={['aspect-[16/10] w-full object-cover', stop.focus]}
											/>
										</div>
									</div>
								</li>
							))
						}
					</ol>
					<div class="hidden lg:col-span-5 lg:col-start-8 lg:block">
						<div class:list={[photoFrame, 'sticky top-28 aspect-[4/5]']}>
							{
								itinerary.map((stop, i) => (
									<Image
										src={stop.photo}
										alt={i === 0 ? stop.alt : ''}
										widths={[640, 1000]}
										sizes="40vw"
										data-photo={i}
										class:list={['itinerary-photo absolute inset-0 size-full object-cover', stop.focus, i === 0 && 'is-active']}
									/>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Before you come: a checklist people can tick off on their phone -->
		<section aria-labelledby="checklist-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<div class="lg:col-span-4">
						<h2 id="checklist-heading" class={h2}>{page.checklistHeading}</h2>
						<p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-ink/75">
							{page.checklistIntro}
						</p>
					</div>
					<ul class="grid gap-x-8 border-b border-ink/10 sm:grid-cols-2 lg:col-span-8">
						{
							page.checklist.map((c, i) => (
								<li class="border-t border-ink/10">
									<label class="group flex cursor-pointer gap-4 py-5 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ink">
										<input type="checkbox" id={`check-${i}`} class="peer sr-only" />
										<span
											class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-md border border-ink/30 text-white transition-colors peer-checked:border-ink peer-checked:bg-ink"
											aria-hidden="true"
										>
											<svg class="size-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8">
												<path d="M2.5 6.2 5 8.5l4.5-5" />
											</svg>
										</span>
										<span class="transition-opacity peer-checked:opacity-50">
											<span class="block text-[0.9375rem] font-medium tracking-[-0.01em] group-has-checked:line-through">{c.item}</span>
											<span class="mt-1 block text-sm text-ink/60">{c.note}</span>
										</span>
									</label>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- A look inside: photography carries this section -->
		<section aria-labelledby="inside-heading" class={section}>
			<div class={sectionInner}>
				<h2 id="inside-heading" class:list={[h2, 'max-w-2xl']}>{page.insideHeading}</h2>
				<ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-3 lg:mt-16">
					{
						inside.map((p, i) => (
							<li class:list={[i === 1 && 'sm:mt-16']}>
								<div class={photoFrame}>
									<Image src={p.photo} alt={p.alt} widths={[480, 900]} sizes="(min-width: 640px) 33vw, 100vw" class:list={['aspect-[4/5] w-full object-cover', p.focus]} />
								</div>
								<p class:list={[smallLabel, 'mt-4']}>{p.caption}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- What you'll leave with -->
		<section aria-labelledby="leave-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<div class="lg:col-span-4">
						<h2 id="leave-heading" class={h2}>{page.leaveHeading}</h2>
						<p class="mt-5 max-w-sm text-[0.9375rem] leading-relaxed text-ink/75">{page.leaveIntro}</p>
					</div>
					<div class="grid gap-x-8 sm:grid-cols-2 lg:col-span-8">
						{
							page.takeaways.map((t) => (
								<div class="border-t border-ink/10 py-6 sm:py-8">
									<h3 class="text-xl tracking-[-0.01em]">{t.title}</h3>
									<p class="mt-2 max-w-sm text-[0.9375rem] leading-relaxed text-ink/75">{t.body}</p>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- Bringing your child: photo and a few reassurances -->
		<section aria-labelledby="child-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
					<div class:list={[photoFrame, 'lg:col-span-6']}>
						<Image src={childPhoto} alt="A young patient smiling" widths={[640, 1000]} sizes="(min-width: 1024px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover object-[50%_35%]" />
					</div>
					<div class="lg:col-span-5 lg:col-start-8">
						<h2 id="child-heading" class={h2}>{page.childHeading}</h2>
						<p class="mt-5 max-w-md text-[0.9375rem] leading-relaxed text-ink/75">
							{page.childIntro}
						</p>
						<ul class="mt-8 border-b border-ink/10">
							{page.childNotes.map((n) => <li class="border-t border-ink/10 py-4 text-lg tracking-[-0.01em]">{n}</li>)}
						</ul>
						<a href={url('/treatments/kids')} class:list={[textLink, 'mt-8']}>
							More about care for kids
							<ArrowIcon size={11} class="text-accent transition-transform motion-safe:group-hover:translate-x-0.5" />
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Getting here -->
		<section aria-labelledby="here-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<h2 id="here-heading" class:list={[h2, 'lg:col-span-4']}>{page.hereHeading}</h2>
					<div class="lg:col-span-8">
						<dl class="border-b border-ink/10">
							{
								details.map((d) => (
									<div class="grid gap-1 border-t border-ink/10 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
										<dt class={smallLabel}>{d.label}</dt>
										<dd class="text-[0.9375rem] leading-relaxed">{d.value}</dd>
									</div>
								))
							}
							<div class="grid gap-1 border-t border-ink/10 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
								<dt class={smallLabel}>Questions</dt>
								<dd class="text-[0.9375rem]">
									<a href={phone.href} class="underline decoration-ink/25 underline-offset-4 transition-colors hover:decoration-accent">{phone.display}</a>
								</dd>
							</div>
						</dl>
						<a href={directionsUrl} target="_blank" rel="noopener noreferrer" class:list={[textLink, 'mt-8']}>
							Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
							<ArrowIcon size={11} class="-rotate-45 text-accent transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5" />
						</a>
					</div>
				</div>
			</div>
		</section>

		<section aria-labelledby="faq-heading" class={section}>
			<div class={sectionInner}>
				<div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
					<h2 id="faq-heading" class:list={[h2, 'lg:sticky lg:top-24 lg:col-span-4 lg:self-start']}>{page.faqHeading}</h2>
					<Accordion items={page.faqs} openFirst={false} class="lg:col-span-8 lg:col-start-5" />
				</div>
			</div>
		</section>

		<ClosingCta heading={page.closing} text={page.closingText} />
	</main>
</Layout>

<style>
	/* Pinned itinerary photos crossfade as the step in view changes. */
	.itinerary-photo {
		opacity: 0;
		transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.itinerary-photo.is-active {
		opacity: 1;
	}
	/* The step in view gets a tangerine dot and a darker time. */
	.stop.is-active .stop-dot {
		border-color: var(--color-accent);
		background: var(--color-accent);
	}
	.stop.is-active .stop-time {
		color: var(--color-ink);
	}
	@media (prefers-reduced-motion: reduce) {
		.itinerary-photo {
			transition: none;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-itinerary]')!;
	const stops = [...root.querySelectorAll<HTMLElement>('[data-stop]')];
	const photos = [...root.querySelectorAll<HTMLElement>('[data-photo]')];

	const activate = (index: number) => {
		stops.forEach((s, i) => s.classList.toggle('is-active', i === index));
		photos.forEach((p, i) => p.classList.toggle('is-active', i === index));
	};

	// The step crossing the middle of the screen is the active one.
	if ('IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) activate(Number((entry.target as HTMLElement).dataset.stop));
				}
			},
			{ rootMargin: '-45% 0px -45% 0px' },
		);
		stops.forEach((s) => observer.observe(s));
	}
	activate(0);
</script>
