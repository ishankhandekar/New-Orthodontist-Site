---
import TreatmentPage from '../../components/TreatmentPage.astro';
import Layout from '../../layouts/Layout.astro';
// TODO: Placeholder photo, and only 473px wide. Swap for a real photo from the practice (1400px+ wide).
import heroImage from '../../assets/treatment-braces.png';
import { fetchDocument, type TreatmentPageContent } from '../../lib/sanity';

/*
	TODO: Placeholder content. Dr. Lee should review every line, especially treatment length,
	adjustment spacing, the bracket types offered and the metal vs. ceramic cost comparison.
*/

// The page's text is edited in Sanity Studio (Treatments → Braces); the photo stays here.
const page = await fetchDocument<TreatmentPageContent>('treatment-braces', { draftMode: Astro.locals.draftMode, stega: true });
---

<Layout title={page.seo.title} description={page.seo.description} image={heroImage} solidHeader>
	<TreatmentPage {...page} image={heroImage} imageAlt="Close-up of a smile with metal braces" imageFocus="object-[50%_60%]" results="braces" />
</Layout>
