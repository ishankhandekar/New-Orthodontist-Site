---
import TreatmentPage from '../../components/TreatmentPage.astro';
import Layout from '../../layouts/Layout.astro';
// TODO: Placeholder photo. Swap for a real photo from the practice (1400px+ wide).
import heroImage from '../../assets/treatment-invisalign.jpg';
import { fetchDocument, type TreatmentPageContent } from '../../lib/sanity';

/*
	TODO: Placeholder content. Dr. Lee should review every line, especially treatment length, visit
	spacing, wear time and the cost wording, and confirm the practice's Invisalign provider details.
*/

// The page's text is edited in Sanity Studio (Treatments → Invisalign); the photo stays here.
const page = await fetchDocument<TreatmentPageContent>('treatment-invisalign', { draftMode: Astro.locals.draftMode, stega: true });
---

<Layout title={page.seo.title} description={page.seo.description} image={heroImage} solidHeader>
	<TreatmentPage {...page} image={heroImage} imageAlt="Clear Invisalign aligners held in open hands" imageFocus="object-[58%_center]" results="invisalign" />
</Layout>
