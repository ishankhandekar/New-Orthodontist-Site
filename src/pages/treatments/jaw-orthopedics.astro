---
import TreatmentPage from '../../components/TreatmentPage.astro';
import Layout from '../../layouts/Layout.astro';
// TODO: Placeholder photo. Swap for a real photo from the practice (1400px+ wide).
import heroImage from '../../assets/treatment-jaw.jpg';
import { fetchDocument, type TreatmentPageContent } from '../../lib/sanity';

/*
	TODO: Placeholder content. Dr. Lee should review every line, especially the age range, treatment
	length, the appliances she uses and what insurance typically covers. No comparison table or
	results section yet; add them once there's real material.
*/

// The page's text is edited in Sanity Studio (Treatments → Jaw Orthopedics); the photo stays here.
const page = await fetchDocument<TreatmentPageContent>('treatment-jaw-orthopedics', { draftMode: Astro.locals.draftMode, stega: true });
---

<Layout title={page.seo.title} description={page.seo.description} image={heroImage} solidHeader>
	<TreatmentPage {...page} image={heroImage} imageAlt="Gloved hand holding a dental model of a patient's teeth" imageFocus="object-[50%_62%]" />
</Layout>
