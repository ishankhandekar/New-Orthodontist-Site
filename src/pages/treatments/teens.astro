---
import AgePage from '../../components/AgePage.astro';
import Layout from '../../layouts/Layout.astro';
// TODO: Placeholder photo (the homepage hero stock photo). Swap for a real photo of a teen patient.
import heroImage from '../../assets/hero-patient.jpg';
import { fetchDocument, type AgePageContent } from '../../lib/sanity';

// TODO: Placeholder content, including Dr. Lee's quote. She should review every line before launch.

// The page's text is edited in Sanity Studio (Ages → Teens); the photo stays here.
const page = await fetchDocument<AgePageContent>('age-teens', { draftMode: Astro.locals.draftMode, stega: true });
---

<Layout title={page.seo.title} description={page.seo.description} image={heroImage} solidHeader>
	<AgePage {...page} image={heroImage} imageAlt="Smiling teen with braces on a sunny street" imageFocus="object-[60%_30%]" />
</Layout>
