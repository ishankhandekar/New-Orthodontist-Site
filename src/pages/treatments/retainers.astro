---
import TreatmentPage from '../../components/TreatmentPage.astro';
import Layout from '../../layouts/Layout.astro';
// TODO: Placeholder photo (a gallery stock portrait). Swap for a real photo from the practice.
import heroImage from '../../assets/gallery-sarah.png';
import { fetchDocument, type TreatmentPageContent } from '../../lib/sanity';

/*
	TODO: Placeholder content. Dr. Lee should review every line, especially the wear schedule, the
	retainer types offered, whether first retainers are included in treatment, and replacement fees.
*/

// The page's text is edited in Sanity Studio (Treatments → Retainers); the photo stays here.
const page = await fetchDocument<TreatmentPageContent>('treatment-retainers', { draftMode: Astro.locals.draftMode, stega: true });
---

<Layout title={page.seo.title} description={page.seo.description} image={heroImage} solidHeader>
	<TreatmentPage {...page} image={heroImage} imageAlt="Smiling patient after finishing treatment" imageFocus="object-[50%_28%]" />
</Layout>
