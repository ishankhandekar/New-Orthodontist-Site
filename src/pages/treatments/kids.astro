---
import AgePage from '../../components/AgePage.astro';
import Layout from '../../layouts/Layout.astro';
// TODO: Placeholder photo (a gallery stock portrait). Swap for a real photo of a young patient.
import heroImage from '../../assets/gallery-priya.png';
import { fetchDocument, type AgePageContent } from '../../lib/sanity';

// TODO: Placeholder content, including Dr. Lee's quote. She should review every line before launch.

// The page's text is edited in Sanity Studio (Ages → Kids); the photo stays here.
const page = await fetchDocument<AgePageContent>('age-kids', { draftMode: Astro.locals.draftMode, stega: true });
---

<Layout title={page.seo.title} description={page.seo.description} image={heroImage} solidHeader>
	<AgePage {...page} image={heroImage} imageAlt="Smiling child outdoors" imageFocus="object-[50%_35%]" />
</Layout>
