---
import type { HomePage } from '../lib/sanity';
import { keepNameTogether } from '../lib/text';
import { url } from '../lib/url';
import Accordion from './Accordion.astro';
import ArrowIcon from './ArrowIcon.astro';

// TODO: Have Dr. Lee review every answer for accuracy (timelines, insurance and financing) before launch.
interface Props {
	content: HomePage['faq'];
}
const { content } = Astro.props;
const faqs = content.items.map((item) => ({ q: item.question, a: item.answer }));
---

<section id="faq" aria-labelledby="faq-heading" class="bg-white px-5 py-20 text-ink sm:px-7 lg:py-28">
	<div class="mx-auto max-w-7xl">
		<!-- Section label row -->
		<div class="flex justify-between text-[11px] tracking-wide text-ink/70 uppercase">
			<span>[ FAQ ]</span>
			<span>[07]</span>
		</div>

		<div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-8">
			<!-- Left: headline, pinned while the questions scroll past on large screens -->
			<h2
				id="faq-heading"
				class="text-[2.125rem] leading-[1.08] font-normal tracking-[-0.01em] text-balance sm:text-[clamp(2.5rem,4.4vw,4rem)] lg:sticky lg:top-24 lg:col-span-4 lg:self-start"
			>
				{keepNameTogether(content.headline)}
			</h2>

			<!-- Right: accordion, then a link to the full FAQ page -->
			<div class="lg:col-span-8 lg:col-start-5">
				<Accordion items={faqs} />
				<a
					href={url('/faq')}
					class="group mt-8 inline-flex items-center gap-2 text-sm font-medium underline decoration-ink/25 underline-offset-[6px] transition-colors hover:decoration-accent focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
				>
					See all questions
					<ArrowIcon size={11} class="text-accent transition-transform motion-safe:group-hover:translate-x-0.5" />
				</a>
			</div>
		</div>
	</div>
</section>

