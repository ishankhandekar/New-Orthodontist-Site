---
// TODO: Placeholder answers; have Dr. Lee review every one for accuracy (timelines,
// insurance and financing) before launch.
// Kept to the questions patients most often ask before booking.
const faqs = [
	{
		q: 'Is the first consultation really free?',
		a: 'Yes. Your first visit, including the digital scan and a sit-down with Dr. Lee to review your options, costs nothing and comes with no obligation.',
	},
	{
		// TODO: If the client wants a starting price shown here, confirm the exact figure first.
		q: 'How much does treatment cost?',
		a: 'Every smile is different, so your cost depends on the treatment you choose and how long it takes. At your free consultation you’ll get a clear, all-inclusive quote with no hidden fees, along with monthly payment options to fit your budget.',
	},
	{
		q: 'How long does treatment usually take?',
		a: 'Most treatment takes between 12 and 24 months, depending on what needs to move and how consistently aligners are worn. You’ll get a personal timeline at your consultation.',
	},
	{
		q: 'Braces or Invisalign: which is right for me?',
		a: 'Both can create excellent results. Invisalign is nearly invisible and removable; braces work around the clock and suit some complex cases better. Dr. Lee will walk you through which fits your teeth and your lifestyle.',
	},
	{
		q: 'Do you accept insurance, and do you offer payment plans?',
		a: 'We accept most major PPO insurance plans and will check your benefits before treatment begins. We also offer flexible in-house payment plans at 0% interest, and we’ll go over every option clearly at your consultation.',
	},
	{
		q: 'At what age should my child have their first visit?',
		a: 'The American Association of Orthodontists recommends a first check-up by age 7. Most children won’t need treatment that early, but it lets Dr. Lee spot jaw growth or bite issues while they’re easiest to guide.',
	},
	{
		q: 'Does treatment hurt?',
		a: 'You may feel some pressure or tenderness for a few days after starting and after adjustments, which usually settles quickly. Most patients manage it with soft foods and an over-the-counter pain reliever.',
	},
	{
		q: 'Am I too old for braces or Invisalign?',
		a: 'Not at all. Healthy teeth can be moved at any age, and many of our patients are adults. Invisalign and clear ceramic braces are popular, discreet options.',
	},
];
---

<section id="faq" aria-labelledby="faq-heading" class="faq bg-white px-5 py-20 text-ink sm:px-7 lg:py-28">
	<div class="mx-auto max-w-7xl">
		<!-- Section label row -->
		<div class="flex justify-between text-[11px] tracking-wide text-ink/70 uppercase">
			<span>[ FAQ ]</span>
			<span>[07]</span>
		</div>

		<div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-12 lg:gap-8">
			<!-- Left: headline, pinned while the questions scroll past on large screens -->
			<h2
				id="faq-heading"
				class="text-[2.125rem] leading-[1.08] font-normal tracking-[-0.01em] text-balance sm:text-[clamp(2.5rem,4.4vw,4rem)] lg:sticky lg:top-24 lg:col-span-4 lg:self-start"
			>
				Everything you need to know.
			</h2>

			<!-- Right: accordion. Native <details>, so it's keyboard and screen-reader friendly with no JS. -->
			<div class="border-b border-ink/10 lg:col-span-8 lg:col-start-5">
				{
					faqs.map((item, i) => (
						<details class="group border-t border-ink/10" open={i === 0}>
							<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink sm:py-7 [&::-webkit-details-marker]:hidden">
								<h3 class="text-lg leading-snug tracking-[-0.01em] sm:text-xl">{item.q}</h3>
								<span
									class="relative flex size-9 shrink-0 items-center justify-center rounded-full border border-ink/20 transition-colors group-hover:border-ink/40 group-open:border-accent group-open:bg-accent"
									aria-hidden="true"
								>
									<span class="absolute h-px w-3.5 bg-current transition-colors group-open:bg-white"></span>
									<span class="absolute h-3.5 w-px bg-current transition-transform duration-300 group-open:scale-y-0"></span>
								</span>
							</summary>
							<p class="max-w-2xl pr-12 pb-7 text-[0.9375rem] leading-relaxed text-ink/75">{item.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* Answers glide open where the browser supports animating <details>; elsewhere they snap. */
	.faq {
		interpolate-size: allow-keywords;
	}
	details::details-content {
		block-size: 0;
		overflow: hidden;
		transition:
			block-size 0.45s cubic-bezier(0.16, 1, 0.3, 1),
			content-visibility 0.45s allow-discrete;
	}
	details[open]::details-content {
		block-size: auto;
	}
	@media (prefers-reduced-motion: reduce) {
		details::details-content {
			transition: none;
		}
	}
</style>
