---
import { socials } from '../lib/contact';
import ArrowIcon from './ArrowIcon.astro';

/*
	Real Google reviews, trimmed to their strongest lines: the reviewer's exact words, with "…"
	wherever text was cut, and their actual star rating. Names are first name and last initial.
	Avatars mimic Google's default profile picture: a solid circle with the reviewer's initial.
*/
const testimonials = [
	{
		name: 'Shannon M.',
		rating: 5,
		quote: 'Dr. Lee is truly exceptional. … My son’s smile has been completely transformed, and we couldn’t be happier with the results.',
		color: '#1e88e5',
	},
	{
		name: 'Rosa M.',
		rating: 5,
		quote: 'The office was closed but Dr. Lee happen to be there and without hesitation asked us to come in so she can fix the wire.',
		color: '#8d6e63',
	},
	{
		name: 'Flore Q.',
		rating: 5,
		quote: 'Our daughter’s case was fairly complex but Dr Lee did a fantastic job and gave our daughter a beautiful smile in under 2 years.',
		color: '#5c6bc0',
	},
	{
		name: 'Seongho B.',
		rating: 5,
		quote: 'We were transferred to Dr. Lee after our previous orthodontist became unavailable, and the transition was seamless.',
		color: '#c2185b',
	},
	{
		name: 'Janice R.',
		rating: 5,
		quote: '…my son was able to finish his braces treatment without teeth being pulled and in a shorter amount of time than his treatment listed.',
		color: '#78909c',
	},
];
// The practice's overall Google rating and review count, as shown on its listing.
const google = { rating: 4.5, count: '40', url: socials.find((s) => s.name === 'Google')!.href };
const total = testimonials.length;
const star = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z';
const navButton =
	'flex size-10 shrink-0 items-center justify-center rounded-full border border-white/50 text-white transition-colors hover:bg-white hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---

<!--
	Full-bleed tangerine band with one centered pull quote at a time, no card. Client design
	choice: white text on the tangerine, though it's below WCAG AA (2.49:1).
-->
<section
	id="testimonials"
	aria-labelledby="testimonials-heading"
	class="bg-accent px-5 py-16 text-white sm:px-7 lg:py-24"
>
	<h2 id="testimonials-heading" class="sr-only">Patient reviews</h2>

	<div
		data-testimonials
		role="region"
		aria-roledescription="carousel"
		aria-label="Patient reviews"
		class="mx-auto max-w-7xl"
	>
		<!-- Section label row -->
		<div class="flex justify-between text-[11px] tracking-wide uppercase">
			<span>[ Testimonials ]</span>
			<span>[06]</span>
		</div>

		<div class="relative mt-14 lg:mt-20">
			<!-- Desktop arrows sit at the band's edges. Revealed by the script, so visitors without JS just see the first quote. -->
			<div data-controls hidden class="contents">
				<button
					type="button"
					data-prev
					aria-label="Previous review"
					class:list={[navButton, 'absolute top-1/2 left-0 hidden -translate-y-1/2 lg:flex']}
				>
					<ArrowIcon size={13} class="rotate-180" />
				</button>
				<button
					type="button"
					data-next
					aria-label="Next review"
					class:list={[navButton, 'absolute top-1/2 right-0 hidden -translate-y-1/2 lg:flex']}
				>
					<ArrowIcon size={13} />
				</button>
			</div>

			<!--
				All quotes share one grid cell, so the block is as tall as the longest and nothing below
				jumps when they crossfade. Polite live region: screen readers hear each new quote.
			-->
			<div aria-live="polite" class="mx-auto grid max-w-[46rem]">
				{
					testimonials.map((t, i) => (
						<figure
							data-slide={i}
							role="group"
							aria-roledescription="slide"
							aria-label={`${i + 1} of ${total}`}
							class:list={['review flex flex-col', i === 0 && 'is-active']}
						>
							<blockquote class="text-[1.625rem] leading-[1.2] tracking-[-0.01em] text-pretty sm:text-[2rem] lg:text-[2.375rem]">
								<p>
									<span class="font-display text-accent-light" aria-hidden="true">“</span>{t.quote}<span class="font-display text-accent-light" aria-hidden="true">”</span>
								</p>
							</blockquote>
							<figcaption class="mt-auto flex items-center gap-3 pt-8">
								<span
									class="flex size-10 shrink-0 items-center justify-center rounded-full text-base text-white select-none"
									style={`background-color: ${t.color}`}
									aria-hidden="true"
								>
									{t.name[0]}
								</span>
								<span class="leading-tight">
									<span class="block text-sm font-medium">{t.name}</span>
									<span class="mt-1 flex gap-0.5">
										<span class="sr-only">{t.rating} out of 5 stars</span>
										{Array.from({ length: 5 }, (_, n) => (
											<svg
												class:list={['size-3.5', n >= t.rating && 'text-white/35']}
												viewBox="0 0 24 24"
												fill="currentColor"
												aria-hidden="true"
											>
												<path d={star} />
											</svg>
										))}
									</span>
								</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>

		<div class="mx-auto mt-12 max-w-[46rem]">
			<!-- Progress segments double as slide picks; on phones the arrows share this row. -->
			<div data-controls hidden class="flex items-center justify-between gap-4">
				<div class="flex gap-1.5">
					{
						testimonials.map((_, i) => (
							<button
								type="button"
								data-dot={i}
								aria-label={`Review ${i + 1} of ${total}`}
								aria-current={i === 0 ? 'true' : 'false'}
								class="group py-3 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-white"
							>
								<span class="block h-0.5 w-8 bg-white/35 transition-colors group-hover:bg-white/70 group-aria-[current=true]:bg-white sm:w-12" />
							</button>
						))
					}
				</div>
				<div class="flex gap-2 lg:hidden">
					<button type="button" data-prev aria-label="Previous review" class={navButton}>
						<ArrowIcon size={13} class="rotate-180" />
					</button>
					<button type="button" data-next aria-label="Next review" class={navButton}>
						<ArrowIcon size={13} />
					</button>
				</div>
			</div>

			<!-- The practice's overall Google rating, in one quiet line. -->
			<p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
				<span class="flex items-center gap-2">
					<span class="font-medium tabular-nums">{google.rating.toFixed(1)}<span class="sr-only"> out of 5 stars</span></span>
					<span class="flex gap-0.5" aria-hidden="true">
						{/* Each star fills by how much of it the rating covers, so 4.5 shows a half star. */}
						{Array.from({ length: 5 }, (_, n) => (
							<span class="relative size-3.5">
								<svg class="absolute inset-0 size-full text-white/35" viewBox="0 0 24 24" fill="currentColor">
									<path d={star} />
								</svg>
								<span class="absolute inset-y-0 left-0 overflow-hidden" style={`width: ${Math.min(Math.max(google.rating - n, 0), 1) * 100}%`}>
									<svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor">
										<path d={star} />
									</svg>
								</span>
							</span>
						))}
					</span>
				</span>
				<span class="text-white/60" aria-hidden="true">·</span>
				<span>{google.count} Google reviews</span>
				<!-- On phones the link drops to its own line rather than leaving a dot dangling. -->
				<span class="text-white/60 max-sm:hidden" aria-hidden="true">·</span>
				<span class="basis-full sm:hidden" aria-hidden="true"></span>
				<a
					href={google.url}
					target="_blank"
					rel="noopener noreferrer"
					class="group inline-flex items-center gap-1.5 border-b border-white/50 pb-0.5 transition-colors hover:border-white focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
				>
					Read all on Google<span class="sr-only"> (opens in a new tab)</span>
					<ArrowIcon
						size={10}
						class="-rotate-45 transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
					/>
				</a>
			</p>
		</div>
	</div>
</section>

<style>
	/* Stacked quotes crossfade; hidden ones also leave the tab order and accessibility tree. */
	.review {
		grid-area: 1 / 1;
		transition:
			opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
			visibility 0.5s;
	}
	.review:not(.is-active) {
		opacity: 0;
		visibility: hidden;
	}
	@media (prefers-reduced-motion: reduce) {
		.review {
			transition: none;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-testimonials]')!;
	const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
	const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
	let current = 0;

	const show = (index: number) => {
		current = (index + slides.length) % slides.length;
		slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
		dots.forEach((d, i) => d.setAttribute('aria-current', String(i === current)));
	};

	for (const c of root.querySelectorAll<HTMLElement>('[data-controls]')) c.hidden = false;
	for (const b of root.querySelectorAll('[data-prev]')) b.addEventListener('click', () => show(current - 1));
	for (const b of root.querySelectorAll('[data-next]')) b.addEventListener('click', () => show(current + 1));
	dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
</script>
