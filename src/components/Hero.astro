---
import { Image } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import { phone } from '../lib/contact';
// TODO: Placeholder stock photo. Swap for a real photo of Dr. Lee with a patient.
import heroImage from '../assets/hero-patient.jpg';
---

<section
	class="relative isolate flex h-svh min-h-[640px] flex-col overflow-hidden bg-neutral-900 text-white"
>
	<!--
		Full-bleed background photo. On desktop the image is widened past the right edge to
		push the face toward the upper right, leaving the lower left open for the headline.
	-->
	<div class="absolute inset-0 -z-10 overflow-hidden">
		<Image
			src={heroImage}
			alt="Smiling teen patient with braces, standing on a sunlit street"
			widths={[640, 1024, 1600, 2000]}
			sizes="(min-width: 1024px) 115vw, 100vw"
			format="webp"
			loading="eager"
			fetchpriority="high"
			class="size-full origin-[60%_35%] object-cover object-[55%_center] lg:w-[115%] lg:max-w-none lg:object-[50%_22%] motion-safe:animate-hero-zoom"
		/>
	</div>
	<!-- Bottom gradient keeps white text readable over any photo; the short top one covers the logo, nav and status pill. -->
	<div class="absolute inset-0 -z-10 bg-linear-to-t from-black/80 via-black/50 via-55% to-transparent sm:from-black/65 sm:via-black/30 sm:via-45%" aria-hidden="true">
	</div>
	<div class="absolute inset-x-0 top-0 -z-10 h-56 bg-linear-to-b from-black/70 to-transparent" aria-hidden="true">
	</div>

	<!-- Status pill. Top padding clears the fixed site header floating over the hero. -->
	<div class="px-5 pt-[5.75rem] sm:px-7 sm:pt-[6.5rem]">
		<span
			class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-ink/50 py-1 pr-3 pl-2 text-[10px] tracking-wide text-white uppercase backdrop-blur-sm"
		>
			<span class="size-1.5 rounded-full bg-accent outline-2 outline-accent/30"></span>
			Now welcoming new patients
		</span>
	</div>

	<!-- Headline + CTA -->
	<div
		class="mt-auto flex flex-col gap-7 px-5 pb-8 sm:px-7 lg:flex-row lg:items-end lg:justify-between lg:pb-9"
	>
		<h1
			class="text-[2.125rem] leading-[1.08] font-normal tracking-[-0.01em] text-balance sm:text-[clamp(2.5rem,4.4vw,4rem)] motion-safe:animate-fade-rise"
		>
			<span class="sm:block">Braces and Invisalign,</span>{' '}
			<span class="sm:block">always with Dr.&nbsp;Judy&nbsp;Lee,</span>{' '}
			<span class="sm:block">right here in Torrey Hills.</span>
		</h1>

		<div class="flex max-w-[17.5rem] flex-col gap-5 lg:mr-[4%] lg:mb-1">
			<p
				class="text-sm leading-snug text-white motion-safe:animate-fade-rise motion-safe:[animation-delay:100ms]"
			>
				You'll see Dr. Lee at every appointment, from your first consult to your final retainer check.
			</p>
			<!-- The entrance animation sits on a wrapper so it doesn't override the button's hover lift. -->
			<div class="motion-safe:animate-fade-rise motion-safe:[animation-delay:200ms]">
				<a
					href="#contact"
					class="group inline-flex w-fit items-center gap-8 rounded-lg bg-white py-1 pr-1 pl-4 text-sm font-medium text-ink transition motion-safe:hover:-translate-y-0.5"
				>
					Schedule a Free Consultation
					<span
						class="flex size-8 items-center justify-center rounded-md bg-accent text-white transition-colors group-hover:bg-accent-dark"
					>
						<ArrowIcon class="transition-transform motion-safe:group-hover:translate-x-0.5" />
					</span>
				</a>
			</div>
		</div>
	</div>

	<!-- Footer strip -->
	<div
		class="mx-5 flex justify-between gap-4 border-t border-white/20 py-3.5 text-xs text-white/90 sm:mx-7"
	>
		<span>Carmel Valley, CA</span>
		<!-- Tap-to-call, set quietly in the strip's own type so it reads as info, not an ad. -->
		<a
			href={phone.href}
			class="tabular-nums underline-offset-4 transition-colors hover:text-white hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
		>
			{phone.display}
		</a>
		<!-- Hidden on phones, where the strip only fits two items and the headline already names Dr. Lee. -->
		<!-- TODO: Confirm credentials (e.g. board-certified) with the client before adding them here. -->
		<span class="hidden sm:inline">Dr. Judy Lee, Orthodontist</span>
	</div>
</section>
