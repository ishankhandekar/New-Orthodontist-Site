---
import { Image } from 'astro:assets';
import { buttonArrow, buttonInk } from '../lib/buttons';
import { bookHref } from '../lib/nav';
import { url } from '../lib/url';
import ArrowIcon from './ArrowIcon.astro';
// TODO: Placeholder stock photos. Swap for a real photo of Dr. Lee and of the office.
import doctorImage from '../assets/about-doctor.jpg';
import officeImage from '../assets/about-office.jpg';

// TODO: Placeholder copy throughout this section; confirm with the client.
// TODO: Re-add a rating line under the portrait card using their real Google rating.
---

<section id="about" class="bg-white px-5 pt-10 pb-20 text-ink sm:px-7 lg:pt-12 lg:pb-28">
	<div class="mx-auto max-w-7xl">
		<!-- Section label row -->
		<div class="flex justify-between text-[11px] tracking-wide text-ink/60 uppercase">
			<span>[ About us ]</span>
			<span>[02]</span>
		</div>

		<!--
			Below lg: one column, 28px gaps. The right column and its bottom row use `contents` so
			their children join this stack and can be reordered: paragraph, portrait card,
			supporting line + button, office photo. (Tablets get a 16:10 portrait and a
			normal-width button so the stack doesn't get oversized.)
			lg+: two columns. The portrait card stretches to the row's height and the office row is
			pinned to the bottom of the right column, so their bottom edges always line up.
		-->
		<div class="mt-7 flex flex-col gap-7 md:mt-10 lg:mt-14 lg:grid lg:grid-cols-12 lg:gap-8">
			<!-- Left: Dr. Lee portrait card -->
			<div class="order-2 lg:order-none lg:col-span-4">
				<div
					class="relative isolate aspect-[4/5] overflow-hidden rounded-2xl md:aspect-[16/10] lg:aspect-auto lg:h-full lg:min-h-[26rem]"
				>
					<Image
						src={doctorImage}
						alt="Smiling doctor in a white coat, seated in a warmly lit office"
						widths={[480, 800, 1200]}
						sizes="(min-width: 1024px) 30vw, 100vw"
						class="absolute inset-0 -z-10 size-full object-cover object-[50%_32%]"
					/>
					<div
						class="absolute inset-0 -z-10 bg-linear-to-t from-black/80 via-black/25 via-40% to-transparent"
						aria-hidden="true"
					>
					</div>
					<!-- TODO: Confirm the exact credential wording with the client (e.g. board-certified). -->
					<p class="absolute inset-x-0 bottom-0 p-6 text-center text-sm leading-snug text-white">
						Dr. Lee (Certified Orthodontist)
					</p>
				</div>
			</div>

			<!-- Right: statement, then supporting line + button beside the office photo -->
			<div class="contents lg:col-span-8 lg:flex lg:flex-col">
				<!--
					Key clause in full ink, the rest muted. Client design choice: ink/50 (3.06:1) passes WCAG AA
					only where the text is 24px+ (wide desktops); on smaller screens AA needs ink/65 (4.74:1).
				-->
				<p
					class="order-1 text-[1.3125rem] leading-[1.4] tracking-[-0.01em] text-pretty text-ink/50 lg:order-none lg:text-[clamp(1.25rem,1.95vw,1.8rem)] lg:leading-[1.25] lg:tracking-[-0.015em]"
				>
					<span class="text-ink">Torrey Hills Orthodontics is Dr.&nbsp;Judy&nbsp;Lee’s independent practice in Carmel Valley,</span>{' '}
					offering braces and Invisalign for kids, teens, and adults. Every treatment plan is designed
					and overseen by her personally, so you’re never handed off to a different provider.
				</p>

				<div
					class="contents lg:mt-auto lg:grid lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-8 lg:pt-10"
				>
					<div class="order-3 flex flex-col gap-5 lg:order-none lg:justify-between">
						<div class="flex flex-col gap-5">
							<p class="max-w-[16rem] text-sm leading-snug text-ink/80">
								Join local families finding their best smile with Dr. Lee.
							</p>
							<a href={url(bookHref)} class:list={[buttonInk, 'w-full md:w-fit']}>
								Schedule a Free Consultation
								<ArrowIcon size={12} class={buttonArrow} />
							</a>
						</div>

						<!-- Small mark, as in the reference. Two-column layout only. -->
						<svg
							class="hidden size-7 shrink-0 text-ink/40 lg:block"
							viewBox="0 0 30 22"
							fill="none"
							stroke="currentColor"
							stroke-width="1.25"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="9.5"></circle>
							<circle cx="19" cy="11" r="9.5"></circle>
						</svg>
					</div>

					<Image
						src={officeImage}
						alt="Bright, calm treatment room with a desk and an orange chair"
						widths={[640, 1024, 1600]}
						sizes="(min-width: 1024px) 38vw, 100vw"
						class="order-4 aspect-[16/10] w-full rounded-2xl object-cover object-[60%_center] lg:order-none lg:self-end"
					/>
				</div>
			</div>
		</div>
	</div>
</section>
