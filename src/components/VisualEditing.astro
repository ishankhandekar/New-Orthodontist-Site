<!--
	Click-to-edit outlines for Sanity Studio's Presentation tool. Built only into the preview Worker
	(see the ~visual-editing alias in astro.config.mjs) and rendered only in draft mode.
-->
<script>
	import { enableVisualEditing } from '@sanity/visual-editing';

	// The pages are rendered on the server, so showing an edit means reloading the page. The library
	// asks for a refresh on every edit (and again a second later), so wait for typing to pause, then
	// reload once: no flicker on every keystroke, and the draft has been saved by the time it loads.
	// The Studio's own refresh button reloads straight away.
	let timer: number | undefined;
	enableVisualEditing({
		zIndex: 1000,
		refresh: (payload) =>
			new Promise<void>(() => {
				clearTimeout(timer);
				timer = window.setTimeout(() => location.reload(), payload.source === 'manual' ? 0 : 500);
			}),
	});
</script>
