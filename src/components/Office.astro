---
import { address, directionsUrl as directions, email, hours, phone, socials } from '../lib/contact';
import { bookHref } from '../lib/nav';
import { url } from '../lib/url';
import ArrowIcon from './ArrowIcon.astro';
import Logo from './Logo.astro';


// Repeated twice: at 32px with 0.2em tracking this runs almost exactly one lap (2765 units),
// so textLength only nudges it to close the loop instead of stretching the letters apart.
const ringPhrase = 'One specialist, start to finish · Torrey Hills Orthodontics · ';
const ringText = ringPhrase + ringPhrase;

// The ring is the section's only orange; labels inside match the site's small grey label style.
// Inside the ring (lg+), sizes are in container query units so the block always fits within it;
// the small text has a floor so it stays readable when the ring is at its smallest.
const label = 'text-[11px] tracking-wide text-ink/60 uppercase lg:text-[max(11px,1.4cqw)]';
const value = 'mt-1.5 text-[1.0625rem] leading-snug tracking-[-0.01em] lg:mt-[0.8cqw] lg:text-[max(15px,2.3cqw)]';
// Click-to-copy values: the copy cursor and a hairline underline on hover hint that they're clickable.
const copyButton =
	'cursor-copy text-left underline decoration-transparent underline-offset-4 transition-colors hover:decoration-ink/25 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink';
const copied = 'copied text-[11px] tracking-wide text-accent-deep uppercase lg:text-[max(11px,1.4cqw)]';
const fullAddress = address.join(', ');
// Action rows: label left, arrow right, hairline rule between, like a short editorial menu.
const actionRow =
	'group flex items-center justify-between gap-6 border-b border-ink/10 py-3.5 text-[0.9375rem] tracking-[-0.01em] transition-colors hover:text-ink/70 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink';
---

<section
	id="contact"
	aria-labelledby="contact-heading"
	class="bg-white px-5 py-20 text-ink sm:px-7 lg:py-16"
>
	<div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-12 lg:gap-8">
		<!-- Left: the smile mark over a headline in the site's hero type, a note, and directions -->
		<div class="lg:col-span-5">
			<Logo variant="mark" class="h-8" />
			<h2
				id="contact-heading"
				class="mt-8 text-[2.125rem] leading-[1.08] font-normal tracking-[-0.01em] text-balance sm:text-[clamp(2.5rem,4.4vw,4rem)]"
			>
				Proud to serve the Carmel Valley community.
			</h2>
			<p class="mt-6 max-w-sm text-base text-ink/60">Visits are by appointment only, so please book ahead.</p>
			<!-- The actions as a short list of hairline rows rather than competing buttons. -->
			<div class="mt-8 max-w-sm border-t border-ink/10">
				<a href={url(bookHref)} class={actionRow}>
					Schedule a Free Consultation
					<ArrowIcon size={12} class="text-accent transition-transform motion-safe:group-hover:translate-x-0.5" />
				</a>
				<a href={directions} target="_blank" rel="noopener noreferrer" class={actionRow}>
					<span>Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span></span>
					<ArrowIcon
						size={12}
						class="-rotate-45 text-accent transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
					/>
				</a>
				<a href={phone.href} class={actionRow}>
					Call us
					<ArrowIcon size={12} class="text-accent transition-transform motion-safe:group-hover:translate-x-0.5" />
				</a>
				<a href={email.href} class={actionRow}>
					Email us
					<ArrowIcon size={12} class="text-accent transition-transform motion-safe:group-hover:translate-x-0.5" />
				</a>
			</div>
		</div>

		<!--
			Right: office details, ringed by a line of text on large screens. overflow-hidden keeps the
			spinning SVG's square corners from poking past the screen edge (which caused sideways
			scroll); the text circle itself always stays inside the square.
		-->
		<div class="relative mx-auto w-full max-w-[52rem] overflow-hidden lg:col-span-7 lg:aspect-square lg:@container">
			<svg
				class="pointer-events-none absolute inset-0 hidden size-full text-accent/55 lg:block motion-safe:animate-ring-spin"
				viewBox="0 0 1000 1000"
				aria-hidden="true"
			>
				<defs>
					<path id="office-ring" d="M 60 500 A 440 440 0 1 1 940 500 A 440 440 0 1 1 60 500"></path>
				</defs>
				<text
					fill="currentColor"
					font-size="32"
					style="text-transform: uppercase; letter-spacing: 0.2em"
				>
					<textPath href="#office-ring" textLength="2765" lengthAdjust="spacing">{ringText}</textPath>
				</text>
			</svg>

			<div class="lg:absolute lg:inset-0 lg:flex lg:items-center lg:justify-center">
				<div class="space-y-8 lg:w-[50cqw] lg:space-y-[3.6cqw]">
					<!-- Phone and address copy on click ("Call us" on the left handles calling). -->
					<div data-copy-group>
						<div class="flex items-baseline gap-2">
							<h3 class={label}>Phone number</h3>
							<span data-copied role="status" class={copied}></span>
						</div>
						<p class={value}>
							<button type="button" data-copy={phone.display} aria-label={`Copy phone number ${phone.display}`} class={copyButton}>
								{phone.display}
							</button>
						</p>
					</div>

					<div data-copy-group>
						<div class="flex items-baseline gap-2">
							<h3 class={label}>Address</h3>
							<span data-copied role="status" class={copied}></span>
						</div>
						<address class:list={[value, 'not-italic']}>
							<button type="button" data-copy={fullAddress} aria-label={`Copy address ${fullAddress}`} class={copyButton}>
								<!-- Non-breaking space keeps "Suite 200" together when the line wraps. -->
								{address[0].replace('Suite ', 'Suite ')}<br />{address[1]}
							</button>
						</address>
					</div>

					<div>
						<h3 class={label}>Office hours</h3>
						<!-- Days and times line up in two columns; rotating days get an asterisk and a footnote. -->
						<dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-[1.0625rem] tracking-[-0.01em] lg:mt-[1cqw] lg:gap-x-[3cqw] lg:gap-y-[0.5cqw] lg:text-[max(15px,2.3cqw)]">
							{
								hours.map((h) => (
									<div class="contents">
										<dt>{h.days}</dt>
										<dd class="tabular-nums">
											{h.time}
											{h.rotational && <span class="text-ink/60">*</span>}
										</dd>
									</div>
								))
							}
						</dl>
						<p class="mt-3 text-[13px] text-ink/60 lg:mt-[1.2cqw] lg:text-[max(12px,1.4cqw)]">
							* Open on a rotating schedule, so call to confirm.
						</p>
					</div>

					<!-- Plain text links in the same label/value rhythm as the rest of the block. -->
					<div>
						<h3 id="office-socials" class={label}>Find us online</h3>
						<ul
							aria-labelledby="office-socials"
							class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1 text-[1.0625rem] tracking-[-0.01em] lg:mt-[0.8cqw] lg:gap-x-[2.6cqw] lg:text-[max(15px,2.3cqw)]"
						>
							{
								socials.map((s) => (
									<li>
										<a
											href={s.href}
											target="_blank"
											rel="noopener"
											class="underline decoration-ink/25 underline-offset-4 transition-colors hover:decoration-accent focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
										>
											{s.name}
											<span class="sr-only"> (opens in a new tab)</span>
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* "Copied" fades in beside the label, then out. */
	.copied {
		opacity: 0;
		transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.copied.is-shown {
		opacity: 1;
	}
	@media (prefers-reduced-motion: reduce) {
		.copied {
			transition: none;
		}
	}
</style>

<script>
	// The Clipboard API needs a secure page; fall back to the older selection-based copy.
	const copyText = async (text: string) => {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const field = Object.assign(document.createElement('textarea'), { value: text, readOnly: true });
			field.style.cssText = 'position:fixed;opacity:0';
			document.body.append(field);
			field.select();
			const ok = document.execCommand('copy');
			field.remove();
			return ok;
		}
	};

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		const status = button.closest('[data-copy-group]')!.querySelector<HTMLElement>('[data-copied]')!;
		let hide: number | undefined;
		let clear: number | undefined;
		button.addEventListener('click', async () => {
			if (!(await copyText(button.dataset.copy!))) return;
			clearTimeout(hide);
			clearTimeout(clear);
			// Setting the text (not just showing it) lets screen readers announce it via role="status".
			status.textContent = 'Copied';
			status.classList.add('is-shown');
			hide = window.setTimeout(() => {
				status.classList.remove('is-shown');
				clear = window.setTimeout(() => (status.textContent = ''), 300);
			}, 1600);
		});
	}
</script>
