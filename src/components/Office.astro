---
import ArrowIcon from './ArrowIcon.astro';
import Logo from './Logo.astro';

const phone = { display: '(858) 481-1771', href: 'tel:+18584811771' };
const address = ['4765 Carmel Mountain Road, Suite 200', 'San Diego, CA 92130'];
const directions =
	'https://www.google.com/maps/dir/?api=1&destination=' +
	encodeURIComponent('4765 Carmel Mountain Road, Suite 200, San Diego, CA 92130');
const hours = [
	{ days: 'Mon, Tue', time: '9–5', rotational: true },
	{ days: 'Wed, Thu', time: '9–5', rotational: false },
	{ days: 'Fri', time: '12–5', rotational: true },
	{ days: 'Sat, Sun', time: 'Closed', rotational: false },
];
// TODO: Add the practice's real profile URLs.
const socials = [
	{ name: 'Facebook', href: '#' },
	{ name: 'Instagram', href: '#' },
	{ name: 'Google', href: '#' },
	{ name: 'Yelp', href: '#' },
];

const ringText = 'One specialist, start to finish · Torrey Hills Orthodontics · ';

// Small orange text uses accent-deep (same hue as the accent, 5.01:1 on white). Inside the ring
// (lg+), sizes are in container query units so the block always fits within the circle.
const label =
	'text-xs font-semibold tracking-[0.14em] text-accent-deep uppercase lg:text-[1.55cqw]';
const value = 'mt-2 text-lg leading-snug lg:mt-[0.9cqw] lg:text-[2.45cqw]';
---

<section
	id="contact"
	aria-labelledby="contact-heading"
	class="bg-white px-5 py-20 text-ink sm:px-7 lg:py-16"
>
	<h2 id="contact-heading" class="sr-only">Office information</h2>

	<div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-12 lg:gap-8">
		<!-- Left: logo lockup, tagline, directions -->
		<div class="lg:col-span-5">
			<Logo variant="lockup" class="w-fit" />
			<p class="mt-8 text-base text-ink/75 sm:text-lg">Proud to serve the Carmel Valley community</p>
			<a
				href={directions}
				target="_blank"
				rel="noopener noreferrer"
				class="group mt-7 inline-flex items-center gap-2.5 border-b border-accent-deep/40 pb-1.5 text-lg text-accent-deep transition-colors hover:border-accent-deep focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
			>
				Get directions<span class="sr-only"> (opens Google Maps in a new tab)</span>
				<ArrowIcon
					size={12}
					class="-rotate-45 transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
				/>
			</a>
			<p class="mt-10 text-base text-ink/75">Appointments must be booked ahead of time.</p>
		</div>

		<!--
			Right: office details, ringed by a line of text on large screens. overflow-hidden keeps the
			spinning SVG's square corners from poking past the screen edge (which caused sideways
			scroll); the text circle itself always stays inside the square.
		-->
		<div class="relative mx-auto w-full max-w-[52rem] overflow-hidden lg:col-span-7 lg:aspect-square lg:@container">
			<svg
				class="pointer-events-none absolute inset-0 hidden size-full text-accent/55 lg:block motion-safe:animate-ring-spin"
				viewBox="0 0 1000 1000"
				aria-hidden="true"
			>
				<defs>
					<path id="office-ring" d="M 60 500 A 440 440 0 1 1 940 500 A 440 440 0 1 1 60 500"></path>
				</defs>
				<text
					fill="currentColor"
					font-size="54"
					font-weight="500"
					style="text-transform: uppercase"
				>
					<textPath href="#office-ring" textLength="2740" lengthAdjust="spacing">{ringText}</textPath>
				</text>
			</svg>

			<div class="lg:absolute lg:inset-0 lg:flex lg:items-center lg:justify-center">
				<div class="space-y-9 lg:w-[50cqw] lg:space-y-[4.2cqw]">
					<div>
						<h3 class={label}>Phone number</h3>
						<p class={value}>
							<a
								href={phone.href}
								class="transition-colors hover:text-accent-deep focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
							>
								{phone.display}
							</a>
						</p>
					</div>

					<div>
						<h3 class={label}>Address</h3>
						<address class:list={[value, 'not-italic']}>
							{address[0]}<br />{address[1]}
						</address>
					</div>

					<div>
						<h3 class={label}>Office hours</h3>
						<dl class="mt-3 space-y-2 text-lg lg:mt-[1.3cqw] lg:space-y-[0.9cqw] lg:text-[2.3cqw]">
							{
								hours.map((h) => (
									<div class="flex flex-wrap items-baseline gap-x-2">
										<dt class="font-semibold">{h.days}</dt>
										<dd>{h.time}</dd>
										{h.rotational && (
											<dd class="ml-1 text-[11px] tracking-[0.12em] text-accent-deep uppercase lg:text-[1.35cqw]">
												Rotational
											</dd>
										)}
									</div>
								))
							}
						</dl>
					</div>

					<ul class="flex gap-3 lg:gap-[1.6cqw]" aria-label="Find us online">
						{
							socials.map((s) => (
								<li>
									<a
										href={s.href}
										aria-label={s.name}
										class="flex size-12 items-center justify-center rounded-full bg-peach text-accent-deep transition-colors hover:bg-accent-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink lg:size-[7.4cqw]"
									>
										{s.name === 'Facebook' && (
											<svg class="size-5 lg:size-[2.5cqw]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
												<path d="M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.5c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.2h2.8V22h3.4z" />
											</svg>
										)}
										{s.name === 'Instagram' && (
											<svg class="size-5 lg:size-[2.5cqw]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
												<rect x="3.5" y="3.5" width="17" height="17" rx="5" />
												<circle cx="12" cy="12" r="4" />
												<circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" />
											</svg>
										)}
										{s.name === 'Google' && (
											<span class="text-xl leading-none font-semibold lg:text-[2.7cqw]" aria-hidden="true">G</span>
										)}
										{s.name === 'Yelp' && (
											<svg class="size-5 lg:size-[2.5cqw]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
												<rect x="10.6" y="2.5" width="2.8" height="8" rx="1.4" />
												<rect x="10.6" y="2.5" width="2.8" height="8" rx="1.4" transform="rotate(72 12 12)" />
												<rect x="10.6" y="2.5" width="2.8" height="8" rx="1.4" transform="rotate(144 12 12)" />
												<rect x="10.6" y="2.5" width="2.8" height="8" rx="1.4" transform="rotate(216 12 12)" />
												<rect x="10.6" y="2.5" width="2.8" height="8" rx="1.4" transform="rotate(288 12 12)" />
											</svg>
										)}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>
	</div>
</section>
