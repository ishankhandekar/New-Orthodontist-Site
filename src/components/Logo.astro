---
import { url } from '../lib/url';
// Smile arc of graduated beads on an archwire, modernized from the practice's original logo.
// The smile is always the accent orange.
// - `nav` (default): home link with a compact stacked wordmark that inherits `currentColor`.
// - `mark`: the smile alone, decorative (office info section); size it with `class`.
interface Props {
	class?: string;
	variant?: 'nav' | 'mark';
}

const { class: className, variant = 'nav' } = Astro.props;
const mark = variant === 'mark';
const Tag = mark ? 'span' : 'a';
const attrs = mark
	? { 'aria-hidden': 'true' as const }
	: { href: url('/'), 'aria-label': 'Torrey Hills Orthodontics home' };

const beads = [
	{ cx: 3, cy: 14, r: 1.8 },
	{ cx: 8.8, cy: 21.6, r: 2.4 },
	{ cx: 16.7, cy: 24.8, r: 3 },
	{ cx: 25.5, cy: 23.1, r: 3.4 },
	{ cx: 33.8, cy: 16.1, r: 2.8 },
	{ cx: 40, cy: 3, r: 2 },
];
---

<Tag {...attrs} class:list={['flex items-center gap-2.5', className]}>
	<svg
		class:list={['w-auto shrink-0 text-accent', mark ? 'h-full' : 'h-7']}
		viewBox="0 0 44 30"
		fill="currentColor"
		aria-hidden="true"
	>
		<path
			d="M3 14C10 30 32 30 40 3"
			fill="none"
			stroke="currentColor"
			stroke-width="1.25"
			stroke-linecap="round"
			opacity="0.45"></path>
		{beads.map((b) => <circle {...b} />)}
	</svg>
	{
		!mark && (
			<span class="flex flex-col text-[13px] leading-[1.1] tracking-[-0.01em]">
				<span class="font-medium">Torrey Hills</span>
				<span class="font-light">Orthodontics</span>
			</span>
		)
	}
</Tag>
