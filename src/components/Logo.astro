---
// Smile arc of graduated beads on an archwire, modernized from the practice's original logo.
// The smile is always the accent orange.
// - `nav` (default): compact stacked wordmark that inherits `currentColor`.
// - `lockup`: large display version (office info section), all in the accent orange:
//   tracked "TORREY HILLS" over a large "Orthodontics". Logos are exempt from contrast rules.
interface Props {
	class?: string;
	variant?: 'nav' | 'lockup';
}

const { class: className, variant = 'nav' } = Astro.props;
const lockup = variant === 'lockup';

const beads = [
	{ cx: 3, cy: 14, r: 1.8 },
	{ cx: 8.8, cy: 21.6, r: 2.4 },
	{ cx: 16.7, cy: 24.8, r: 3 },
	{ cx: 25.5, cy: 23.1, r: 3.4 },
	{ cx: 33.8, cy: 16.1, r: 2.8 },
	{ cx: 40, cy: 3, r: 2 },
];
---

<a
	href="/"
	aria-label="Torrey Hills Orthodontics home"
	class:list={['flex', lockup ? 'items-end gap-4 text-accent' : 'items-center gap-2.5', className]}
>
	<svg
		class:list={['w-auto shrink-0 text-accent', lockup ? 'mb-1 h-10 sm:h-16' : 'h-7']}
		viewBox="0 0 44 30"
		fill="currentColor"
		aria-hidden="true"
	>
		<path
			d="M3 14C10 30 32 30 40 3"
			fill="none"
			stroke="currentColor"
			stroke-width="1.25"
			stroke-linecap="round"
			opacity="0.45"></path>
		{beads.map((b) => <circle {...b} />)}
	</svg>
	{
		lockup ? (
			<span class="flex flex-col">
				<span class="text-xs font-medium tracking-[0.32em] uppercase sm:text-sm">Torrey Hills</span>
				<!-- Scales with the screen on small phones so the lockup never overflows. -->
				<span class="mt-1 text-[clamp(1.75rem,10vw,2.5rem)] leading-none font-light tracking-[-0.01em] sm:text-5xl">Orthodontics</span>
			</span>
		) : (
			<span class="flex flex-col text-[13px] leading-[1.1] tracking-[-0.01em]">
				<span class="font-medium">Torrey Hills</span>
				<span class="font-light">Orthodontics</span>
			</span>
		)
	}
</a>
