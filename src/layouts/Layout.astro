---
import { url } from '../lib/url';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title?: string;
	/** Focused pages (like the consultation intake) skip the site header and footer. */
	bare?: boolean;
	/** Pages without a photo hero start with the solid white header. */
	solidHeader?: boolean;
}

const { title = 'Torrey Hills Orthodontics', bare = false, solidHeader = false } = Astro.props;
// Cloudflare Web Analytics: free, cookie-free, and collects no personal data, so it's safe on every
// page of a medical site. It only loads once the practice's token is set (PUBLIC_CF_ANALYTICS_TOKEN,
// passed in by the deploy workflow), so nothing is tracked during development.
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Playfair+Display:wght@400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		{
			cfAnalyticsToken && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={JSON.stringify({ token: cfAnalyticsToken })}
				/>
			)
		}
	</head>
	<body class="bg-white font-sans text-ink antialiased">
		{!bare && <SiteHeader solid={solidHeader} />}
		<slot />
		{!bare && <SiteFooter />}
	</body>
</html>
