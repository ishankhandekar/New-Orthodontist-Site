// Cloudflare deploy settings for both Workers built from this repo.
{
	// The public site: fully static. `npm run build` writes plain HTML to dist/, and this Worker only
	// serves those files (no server code). Having this file also stops `wrangler deploy` from
	// auto-configuring the project as a server-rendered Astro app.
	"name": "torrey-hills-orthodontics",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		// /about/team and /about/team/ both serve about/team/index.html.
		"html_handling": "auto-trailing-slash",
	},
	"env": {
		// The preview site for Sanity Studio's Presentation tool, built with SANITY_PREVIEW=true and
		// CLOUDFLARE_ENV=preview. The Astro Cloudflare adapter adds the server entry and points the
		// assets at its own build output. Needs the SANITY_VIEWER_TOKEN secret.
		"preview": {
			"name": "torrey-hills-orthodontics-preview",
			"assets": {
				"binding": "ASSETS",
				"html_handling": "auto-trailing-slash",
			},
		},
	},
}
